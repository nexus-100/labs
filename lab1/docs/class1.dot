digraph G {
  graph [rankdir=BT, nodesep=0.35, ranksep=0.55, dpi=170, splines=ortho,
         fontname="DejaVu Sans"];
  node [shape=plaintext, fontname="DejaVu Sans", fontsize=9];
  edge [fontname="DejaVu Sans", fontsize=8];
  Entity [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#E8EEF7"><B><I>Entity</I></B></TD></TR><TR><TD ALIGN="LEFT">- _id: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ id: int<BR ALIGN="LEFT"/>+ to_dict(): dict<BR ALIGN="LEFT"/>+ from_dict(data): Entity<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Accessory [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#FFFFFF"><B>Accessory</B></TD></TR><TR><TD ALIGN="LEFT">- _name: str<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ name: str<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Station [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#FFFFFF"><B>Station</B></TD></TR><TR><TD ALIGN="LEFT">- _name: str<BR ALIGN="LEFT"/>- _address: str<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" HEIGHT="6"> </TD></TR></TABLE>>];
  Customer [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#FFFFFF"><B>Customer</B></TD></TR><TR><TD ALIGN="LEFT">- _full_name: str<BR ALIGN="LEFT"/>- _email: str<BR ALIGN="LEFT"/>- _birth_date: date<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ age_on(day): int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Bike [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#E8EEF7"><B><I>Bike</I></B></TD></TR><TR><TD ALIGN="LEFT">- _model: str<BR ALIGN="LEFT"/>- _price_per_hour: float<BR ALIGN="LEFT"/>+ station_id: int<BR ALIGN="LEFT"/>+ accessory_ids: list[int]<BR ALIGN="LEFT"/>+ KIND, MAX_HOURS, MIN_AGE,<BR ALIGN="LEFT"/>   REQUIRES_APPROVAL<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ initial_status(): RentalStatus<BR ALIGN="LEFT"/>+ calculate_cost(slot): float<BR ALIGN="LEFT"/>+ check_rental(slot, customer)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  CityBike [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#FFFFFF"><B>CityBike</B></TD></TR><TR><TD ALIGN="LEFT">KIND = &#x27;city&#x27;<BR ALIGN="LEFT"/>MAX_HOURS = 24<BR ALIGN="LEFT"/>MIN_AGE = 12<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" HEIGHT="6"> </TD></TR></TABLE>>];
  ElectricBike [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#FFFFFF"><B>ElectricBike</B></TD></TR><TR><TD ALIGN="LEFT">KIND = &#x27;electric&#x27;<BR ALIGN="LEFT"/>MAX_HOURS = 8<BR ALIGN="LEFT"/>MIN_AGE = 16<BR ALIGN="LEFT"/>REQUIRES_APPROVAL = True<BR ALIGN="LEFT"/>+ battery_wh: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" HEIGHT="6"> </TD></TR></TABLE>>];
  Rental [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#FFFFFF"><B>Rental</B></TD></TR><TR><TD ALIGN="LEFT">+ bike_id: int<BR ALIGN="LEFT"/>+ customer_id: int<BR ALIGN="LEFT"/>+ slot: TimeSlot<BR ALIGN="LEFT"/>+ cost: float<BR ALIGN="LEFT"/>- _status: RentalStatus<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ confirm()<BR ALIGN="LEFT"/>+ cancel()<BR ALIGN="LEFT"/>+ is_active: bool<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  TimeSlot [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#FFFFFF"><B>TimeSlot</B></TD></TR><TR><TD ALIGN="LEFT">- _start: datetime<BR ALIGN="LEFT"/>- _end: datetime<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ duration_hours: float<BR ALIGN="LEFT"/>+ overlaps(other): bool<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  RentalStatus [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#FFFFFF"><B>«enumeration»<BR/>RentalStatus</B></TD></TR><TR><TD ALIGN="LEFT">PENDING<BR ALIGN="LEFT"/>CONFIRMED<BR ALIGN="LEFT"/>CANCELLED<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" HEIGHT="6"> </TD></TR></TABLE>>];
  Notification [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#FFFFFF"><B>Notification</B></TD></TR><TR><TD ALIGN="LEFT">+ recipient_email: str<BR ALIGN="LEFT"/>+ text: str<BR ALIGN="LEFT"/>+ created_at: datetime<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" HEIGHT="6"> </TD></TR></TABLE>>];
  Repository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#FFFFFF"><B>Repository&lt;T&gt;</B></TD></TR><TR><TD ALIGN="LEFT">- _items: dict[int, T]<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ next_id(): int<BR ALIGN="LEFT"/>+ add(item): T<BR ALIGN="LEFT"/>+ get(id): T<BR ALIGN="LEFT"/>+ all(): list[T]<BR ALIGN="LEFT"/>+ find(predicate): list[T]<BR ALIGN="LEFT"/>+ update(item): T<BR ALIGN="LEFT"/>+ delete(id): T<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  RentalService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#FFF6DD"><B>RentalService</B></TD></TR><TR><TD ALIGN="LEFT">+ stations, accessories, bikes,<BR ALIGN="LEFT"/>   customers, rentals:<BR ALIGN="LEFT"/>   Repository[...]<BR ALIGN="LEFT"/>+ notifications: list[Notification]<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ create_rental(...): Rental<BR ALIGN="LEFT"/>+ reschedule_rental(...)<BR ALIGN="LEFT"/>+ approve_rental(id)<BR ALIGN="LEFT"/>+ cancel_rental(id)<BR ALIGN="LEFT"/>+ find_free_bikes(...)<BR ALIGN="LEFT"/>+ move_bike(id, station_id)<BR ALIGN="LEFT"/>+ delete_bike(id) / delete_customer(id)<BR ALIGN="LEFT"/>+ export_data() / import_data(data)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Storage [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#E8EEF7"><B><I>Storage</I></B></TD></TR><TR><TD ALIGN="LEFT">+ path: Path<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ save(service)<BR ALIGN="LEFT"/>+ load(service)<BR ALIGN="LEFT"/># _write(data)<BR ALIGN="LEFT"/># _read(): dict<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  JsonStorage [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#FFFFFF"><B>JsonStorage</B></TD></TR><TR><TD ALIGN="LEFT" HEIGHT="6"> </TD></TR><TR><TD ALIGN="LEFT"># _write(data)<BR ALIGN="LEFT"/># _read(): dict<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  XmlStorage [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#FFFFFF"><B>XmlStorage</B></TD></TR><TR><TD ALIGN="LEFT" HEIGHT="6"> </TD></TR><TR><TD ALIGN="LEFT"># _write(data)<BR ALIGN="LEFT"/># _read(): dict<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ConsoleApp [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#E7F5E8"><B>ConsoleApp</B></TD></TR><TR><TD ALIGN="LEFT">- service: RentalService<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ run()<BR ALIGN="LEFT"/>+ create_rental() ...<BR ALIGN="LEFT"/>+ save_data()<BR ALIGN="LEFT"/>+ load_data()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Accessory -> Entity [arrowhead=empty];
  Station -> Entity [arrowhead=empty];
  Customer -> Entity [arrowhead=empty];
  Bike -> Entity [arrowhead=empty];
  Rental -> Entity [arrowhead=empty];
  CityBike -> Bike [arrowhead=empty];
  ElectricBike -> Bike [arrowhead=empty];
  JsonStorage -> Storage [arrowhead=empty];
  XmlStorage -> Storage [arrowhead=empty];
  Repository -> Entity [arrowhead=vee, style=dashed, label="T"];
  Rental -> TimeSlot [arrowhead=none, arrowtail=diamond, dir=both];
  Rental -> RentalStatus [arrowhead=vee];
  Rental -> Bike [arrowhead=vee, label="bike_id"];
  Rental -> Customer [arrowhead=vee, label="customer_id"];
  Bike -> Station [arrowhead=vee];
  Bike -> Accessory [arrowhead=vee, label="0..*"];
  RentalService -> Repository [arrowhead=none, arrowtail=diamond, dir=both, label="5"];
  RentalService -> Notification [arrowhead=none, arrowtail=diamond, dir=both, label="0..*"];
  Storage -> RentalService [arrowhead=vee, style=dashed];
  ConsoleApp -> RentalService [arrowhead=vee];
  ConsoleApp -> Storage [arrowhead=vee, style=dashed];
}
